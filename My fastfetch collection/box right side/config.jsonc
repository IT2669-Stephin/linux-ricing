{
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/2.png",
    "width": 28,
    "height": 12,
    "padding": {
      "top": 1,
      "left": 4,
      "bottom": 4,
    },
  },

  "display": { "separator": " " },
  "modules": [
    "break",
    { "key": "╭───────────╮", "type": "custom" },
    { "key": "│  user    │", "type": "title", "format": "{user-name}" },
    { "key": "│ 󰅐 uptime  │", "type": "uptime" },
    { "key": "│  distro  │", "type": "os"},
    { "key": "│  kernel  │", "type": "kernel" },
    { "key": "│  wm      │", "type": "wm" },
    {
      "key": "│  term    │",
      "type": "terminal",
      "format": "ghostty terminal",
    },
    { "key": "│  shell   │", "type": "shell","format": "fish shell"},
    { "key": "│ 󰍛 cpu     │", "type": "cpu","format": "AMD Ryzen 5 3550H" },
    {
      "key": "│ 󰉉 disk    │",
      "type": "disk",
      //"folders": "/",
      "format": "{1} / {2} ({3})",
    },
    { "key": "│  memory  │", "type": "memory" },
    { "key": "╰───────────╯", "type": "custom" },
    "break",
  ],
}
